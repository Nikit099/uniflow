APP_ENV=development
PUBLIC_BASE_URL=http://localhost:8080
ALLOWED_ORIGINS=http://localhost:8080,http://localhost:5173
DATABASE_URL=postgresql+asyncpg://uniflow:uniflow_demo_only@db:5432/uniflow
SESSION_SECRET=
DEMO_MODE=true
DEMO_AUTH_ENABLED=true
DEMO_SEED=true
FILE_STORAGE_BACKEND=filesystem
FILE_STORAGE_PATH=/data/uploads
FILE_MAX_SIZE_MB=10
MAX_ENABLED=false
MAX_API_BASE_URL=https://platform-api2.max.ru
MAX_BOT_TOKEN=
MAX_WEBHOOK_SECRET=
MAX_WEBAPP_AUTH_MAX_AGE_SECONDS=3600
LLM_ENABLED=false
LLM_CONFIG_PATH=/app/config/llm-profiles.yaml
# Select exactly one active backend: gigachat, routerai or openai_compatible.
LLM_PROVIDER=gigachat
# GigaChat: this is the authorization key, not the 30-minute access token.
LLM_GIGACHAT_AUTHORIZATION_KEY=
LLM_GIGACHAT_SCOPE=GIGACHAT_API_PERS
LLM_GIGACHAT_BASE_URL=https://api.giga.chat/v1
LLM_GIGACHAT_OAUTH_URL=https://ngw.devices.sberbank.ru:9443/api/v2/oauth
LLM_GIGACHAT_MODEL=GigaChat-3-Ultra
# RouterAI: use the exact model ID shown in its Models catalogue, e.g. a DeepSeek model.
LLM_ROUTERAI_BASE_URL=https://routerai.ru/api/v1
LLM_ROUTERAI_API_KEY=
LLM_ROUTERAI_MODEL=
# Generic OpenAI-compatible fallback.
LLM_PRIMARY_BASE_URL=
LLM_PRIMARY_API_KEY=
LLM_PRIMARY_MODEL=
LOG_LEVEL=INFO
